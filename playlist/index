function norm(s){return(s||"").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/[^\p{L}\p{N}\s]/gu," ").replace(/\s+/g," ").trim();}
function jsonp(url,timeout=10000){return new Promise((resolve,reject)=>{
 const cb="ht_"+Date.now()+"_"+Math.random().toString(36).slice(2),s=document.createElement("script");let done=false;
 const clean=()=>{clearTimeout(t);delete window[cb];s.remove();},fail=e=>{if(done)return;done=true;clean();reject(e);};
 const t=setTimeout(()=>fail(new Error("timeout")),timeout);
 window[cb]=d=>{if(done)return;done=true;clean();resolve(d);};
 s.onerror=()=>fail(new Error("network"));s.src=url+(url.includes("?")?"&":"?")+"callback="+cb;document.body.appendChild(s);
});}
function score(x,s){const t=norm(s.title),a=norm(s.artist),xt=norm(x.trackName),xa=norm(x.artistName);let n=0;
 if(xt===t)n+=1000;else if(xt.includes(t)||t.includes(xt))n+=300;
 if(xa===a)n+=1000;else if(xa.includes(a)||a.includes(xa))n+=300;return n;}
async function itunesSearch(s){
 const q=encodeURIComponent((s.artist||"")+" "+(s.title||""));
 const d=await jsonp("https://itunes.apple.com/search?term="+q+"&media=music&entity=song&limit=50&country=ES&lang=es_es");
 const arr=(d.results||[]).filter(x=>x.trackName&&x.artistName).sort((a,b)=>score(b,s)-score(a,s));
 return arr;
}
async function getYear(s){
 try{
  const arr=await itunesSearch(s);
  const exact=arr.find(x=>norm(x.trackName)===norm(s.title)&&norm(x.artistName)===norm(s.artist));
  const x=exact||arr[0];
  if(x&&x.releaseDate)return String(x.releaseDate).slice(0,4);
 }catch(e){}
 return "";
}
async function getPreview(s){
 const q=encodeURIComponent((s.artist||"")+" "+(s.title||""));
 // For INNA/MDA, prefer exact iTunes match.
 const art=norm(s.artist);
 if(art==="inna"||art==="mda"||art.includes("mda")){
  try{const arr=await itunesSearch(s);const x=arr.find(x=>norm(x.trackName)===norm(s.title)&&norm(x.artistName)===norm(s.artist))||arr.find(x=>x.previewUrl);if(x&&x.previewUrl)return x.previewUrl;}catch(e){}
 }
 try{
  const d=await jsonp("https://api.deezer.com/search?q="+q+"&limit=50&output=jsonp");
  const arr=(d.data||[]).filter(x=>x.preview);
  arr.sort((a,b)=>((norm(b.title)===norm(s.title)?1000:0)+(norm(b.artist&&b.artist.name)===norm(s.artist)?1000:0))-((norm(a.title)===norm(s.title)?1000:0)+(norm(a.artist&&a.artist.name)===norm(s.artist)?1000:0)));
  if(arr[0])return arr[0].preview;
 }catch(e){}
 const arr=await itunesSearch(s);const x=arr.find(x=>x.previewUrl);
 if(x)return x.previewUrl;throw new Error("Sin preview");
}
